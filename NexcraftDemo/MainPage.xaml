<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NexcraftDemo.Controls"
             x:Class="NexcraftDemo.MainPage"
             Title="Cotizador Nexcraft">

    <VerticalStackLayout Padding="24" Spacing="16">

        <Label Text="Cotizador Nexcraft 3D" FontSize="26" FontAttributes="Bold" />

        <Label Text="Entry normal (sin handler)" />
        <Entry Placeholder="Gramos de filamento" Keyboard="Numeric" />

        <Label Text="NexEntry (con handler)" />
        <controls:NexEntry Placeholder="Gramos de filamento"
                           Keyboard="Numeric"
                           Text="{Binding Gramos}"
                           AccentColor="{Binding Acento}" />

        <Label Text="Costo estimado" />
        <Label Text="{Binding Total}" FontSize="32" FontAttributes="Bold" />

        <Button Text="Cambiar color de acento"
                Command="{Binding CambiarAcentoCommand}" />

    </VerticalStackLayout>
</ContentPage>